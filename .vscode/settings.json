{
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": { "**/node_modules/**": true },
  "search.exclude": { "**/node_modules": true, "**/package-lock.json": true },
  "[shellscript]": { "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode" },
  "[lua]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" }
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": { "source.fixAll.biome": "explicit" }
  }
}
