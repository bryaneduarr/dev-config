  "defaultTools": [],
  "hideThinkingBlock": false,
  "showLastPrompt": false,
  "powerline": {
    "preset": "ascii",
    "placement": "below",
    "welcome": false,
    "separator": "ascii",
    "workingIndicatorPlacement": "above-powerline",
    "customItems": [
      {
        "id": "fast",
        "statusKey": "codex-fast-mode",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": true
      },
      {
        "id": "session",
        "statusKey": "harness-session",
        "position": "right",
        "selfColorize": true,
        "hideWhenMissing": true
      }
    ],
    "layout": {
      "left": [
        "model",
        "custom:fast",
        "thinking",
        "path",
        "git"
      ],
      "right": [
        "context_pct",
        "custom:session"
      ],
      "secondary": []
    },
    "model": {
      "display": "name",
      "showThinkingLevel": false
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 60
    },
    "git": {
      "showBranch": true,
      "showStaged": false,
      "showUnstaged": true,
      "showUntracked": false,
      "polling": "full"
    }
  },
  "quietStartup": true,
  "theme": "catppuccin-mocha",
  "tuiMode": "fullscreen",
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "workingVibe": "off"
}
