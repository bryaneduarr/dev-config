#!/usr/bin/env bash
set -euo pipefail

readonly data_dir="${DEV_CONFIG_DATA_DIR:-$HOME/.local/share/dev-config}"
readonly entry_point="$data_dir/rule-audit/rule-audit.ts"

export PATH="$data_dir/node/bin:$PATH"
export NODE_OPTIONS="--disable-warning=ExperimentalWarning ${NODE_OPTIONS:-}"

exec node "$entry_point" "$@"
